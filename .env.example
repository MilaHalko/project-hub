APP_NAME=Project Hub
APP_DEBUG=false

# Host ports used by docker compose.
APP_PORT=8000
APP_DB_PORT=55433

# Local development credentials only. Never reuse these anywhere else.
POSTGRES_USER=project_hub
# Interpolated into a URL: avoid @ / : % in the password (or URL-encode them).
POSTGRES_PASSWORD=project_hub
POSTGRES_DB=project_hub

# Admin connection used by the test suite to create throwaway databases.
# pytest reads TEST_DATABASE_URL only from the shell environment, not from this
# file. The default (below) matches the values above; when you override
# APP_DB_PORT or POSTGRES_*, export a matching URL, keeping its port and
# credentials in step:
# export TEST_DATABASE_URL=postgresql://project_hub:project_hub@localhost:55433/postgres
