APP_NAME=Project Hub
APP_DEBUG=false

# Host ports used by docker compose.
APP_PORT=8000
APP_DB_PORT=55433

# Local development credentials only. Never reuse these anywhere else.
POSTGRES_USER=project_hub
POSTGRES_PASSWORD=project_hub
POSTGRES_DB=project_hub

# Admin connection used by the test suite to create throwaway databases.
TEST_DATABASE_URL=postgresql://project_hub:project_hub@localhost:55433/postgres
