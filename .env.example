APP_NAME=Project Hub
APP_DEBUG=false

# Data layer: "orm" (SQLAlchemy) or "sql" (psycopg).
APP_DB_BACKEND=orm
# APP_DATABASE_URL=postgresql://project_hub:project_hub@localhost:55433/project_hub

# Signs login tokens. Required for POST /login (without it /login answers 500).
# At least 32 characters; never commit a real value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_JWT_SECRET=

# File storage (S3). Unset APP_S3_BUCKET disables documents; set it only on purpose, because
# with APP_S3_ENDPOINT_URL unset it targets real AWS (docker compose has its own default
# bucket and points the api at its moto emulator, http://s3:5000).
# APP_S3_BUCKET=project-hub-documents
# APP_S3_ENDPOINT_URL=http://localhost:55435
APP_S3_REGION=eu-west-1
# boto3 reads AWS credentials from its standard chain, not from APP_* settings. Compose and
# the tests use the dummy keys "test"/"test", which moto accepts. Never put real AWS keys here.

# Document upload limits: bytes per file (1-104857600) and files per request (1-100).
# APP_DOCUMENT_MAX_BYTES=10485760
# APP_DOCUMENT_MAX_FILES=10

# Host ports used by docker compose.
APP_PORT=8000
APP_DB_PORT=55433
APP_S3_PORT=55435

# Local development credentials only. Never reuse these anywhere else.
POSTGRES_USER=project_hub
# Interpolated into a URL: avoid @ / : % in the password (or URL-encode them).
POSTGRES_PASSWORD=project_hub
POSTGRES_DB=project_hub

# Admin connection used by the test suite to create throwaway databases.
# pytest reads TEST_DATABASE_URL only from the shell environment, not from this
# file. The default (below) matches the values above; when you override
# APP_DB_PORT or POSTGRES_*, export a matching URL, keeping its port and
# credentials in step:
# export TEST_DATABASE_URL=postgresql://project_hub:project_hub@localhost:55433/postgres
# The tests also need the S3 emulator (docker compose up -d --wait s3). Its default URL
# matches APP_S3_PORT above; export a matching one when you change that port:
# export TEST_S3_ENDPOINT_URL=http://localhost:55435
